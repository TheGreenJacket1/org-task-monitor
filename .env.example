# Konfigurasi Supabase Free (Opsional - Bisa diisi langsung via menu Pengaturan di UI aplikasi)
# Dapatkan Project URL dan Anon Key dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base path GitHub Pages (nama repositori, harus diawali dan diakhiri '/')
VITE_BASE_PATH=/org-task-monitor/
